{
  "manifest_version": 3,
  "name": "ChCTV Helper",
  "version": "0.1.0",
  "description": "ChCTV 멀티뷰에서 CHZZK 라이브 방송 재생을 지원하는 보조 확장 프로그램입니다.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["declarativeNetRequest", "scripting", "webNavigation"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://chctv.vercel.app/*",
    "https://chzzk.naver.com/live/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "chctv_live_iframe",
        "enabled": true,
        "path": "rules/chctv-live-iframe.json"
      }
    ]
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://chctv.vercel.app/*"],
      "js": ["src/content/index.js"],
      "run_at": "document_start"
    }
  ]
}
